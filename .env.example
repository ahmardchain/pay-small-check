# Copy to .env. Never commit .env.

# Agent wallet. This key pays buy and, unless PAY_TO is set, receives user checks.
# 32-byte hex. The file stays on the machine that runs the server.
AGENT_PRIVATE_KEY=

# Address that receives the user's cNGN or USD₮. Defaults to the agent wallet.
PAY_TO=

# mock: fixtures, no signed payments. live: pay the buy gateway on Celo mainnet.
BUY_MODE=mock

# open: the page can run a check with no user payment (demo).
# x402: the page is a seller. Users pay in cNGN or USD₮.
PAYMENT_MODE=open

# Token the agent spends at the buy gateway. The gateway accepts USDC, USD₮, USA₮.
# It does not accept cNGN. Fund this wallet with the token you name here.
BUY_TOKEN=USDT

# Seller prices, in atomic units (6 decimals). Defaults: $0.08 and 120 cNGN.
CHECK_PRICE_USDT=80000
CHECK_PRICE_CNGN=120000000

# From https://x402.celo.org after you connect the PayTo wallet. Required for live settlement.
X402_API_KEY=

# Optional. Empty uses the code derived from ahmardchain/pay-small-check.
ATTRIBUTION_CODE=

# Public URL of this app, used in the ERC-8004 registration file.
AGENT_ENDPOINT=

CELO_RPC_URL=https://forno.celo.org
PORT=8787
