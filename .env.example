# Copy to .dev.vars for `wrangler dev` (gitignored). Never commit real keys.
# Secrets are read from the environment. Wrangler vars in wrangler.jsonc are public.

# Set to false only after the agent wallet is funded and the facilitator key exists.
DRY_RUN=true

# Private key for the agent wallet 0x8e23e92f0ec2bd6B8D004Bc913C17AE412322d08.
# That address pays buy and receives the buyer's fee. Keep the key here only,
# in .dev.vars or a Wrangler secret. Never commit it.
AGENT_PRIVATE_KEY=

# Public PayTo. x402 settlement cannot carry an ERC-8021 suffix, so this
# address is how those payments are attributed. A zero address means "not set".
PAY_TO=0x8e23e92f0ec2bd6B8D004Bc913C17AE412322d08

# From https://x402.celo.org — Create API key. Used only to settle buyer payments.
# buy calls do not need this key. The agent wallet pays those directly.
X402_API_KEY=

# Celo mainnet RPC. Do not point this at a testnet.
CELO_RPC_URL=https://forno.celo.org

# Token the agent spends at the buy gateway. USDC, USDT, or USAT.
BUY_TOKEN=USDT

# Hard cap for a single buy call, in 6-decimal atomic units. 20000 = $0.02.
# The live 402 is the price. Anything above this cap is refused before signing.
MAX_BUY_ATOMIC_PER_CALL=20000

# What the buyer pays for one check. 0.08 covers about six $0.005 data calls.
CHECK_PRICE_USD=0.08

# Hackathon-issued ERC-8021 builder code for registration and MiniPay transfers.
ATTRIBUTION_CODE=celo_aac08e9358f3

# Optional. Filled in after scripts/register-8004.ts mints the agent NFT.
AGENT_ID=

# Public origin, no trailing slash. Used in the ERC-8004 registration file.
# Example: https://pay-small-check.<account>.workers.dev
PUBLIC_APP_URL=

BUY_GATEWAY_CATALOG=https://gateway.usebuy.ai/v1/catalog
X402_FACILITATOR_URL=https://api.x402.celo.org
GITHUB_REPO=ahmardchain/pay-small-check
