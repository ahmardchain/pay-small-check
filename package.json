{
  "name": "pay-small-check",
  "version": "1.0.0",
  "private": true,
  "description": "Check an X vendor before you pay them. The agent buys real X data through buy on Celo and returns a Safe, Caution, or Risky verdict.",
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "dry-run": "vite build && wrangler deploy --dry-run",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc -p web",
    "test": "tsx --test test/**/*.test.ts",
    "register:8004": "tsx scripts/register-8004.ts",
    "check:dry": "tsx scripts/dry-run-check.ts",
    "db:migrate:local": "wrangler d1 migrations apply pay-small-check --local",
    "db:migrate": "wrangler d1 migrations apply pay-small-check --remote",
    "build": "vite build",
    "dev:web": "vite"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@celo/attribution-tags": "^0.5.0",
    "@x402/core": "^2.30.0",
    "@x402/evm": "^2.30.0",
    "@x402/fetch": "^2.30.0",
    "@x402/hono": "^2.30.0",
    "hono": "^4.13.16",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.5",
    "wrangler": "^4.45.0"
  }
}
